<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Evomusic.App.Pages"
             x:Class="Evomusic.App.Pages.HomePage"
             x:DataType="pages:HomePage"
             ControlTemplate="{StaticResource PlayerChrome}"
             Title="Home">

    <Grid>
        <!-- Signed out -->
        <VerticalStackLayout
            IsVisible="{Binding IsSignedOut}"
            VerticalOptions="Center"
            Padding="32"
            Spacing="16">
            <Label Text="Evomusic" Style="{StaticResource Headline}" />
            <Label
                Text="Sign in with your Google account to see your YouTube Music library and recommendations."
                HorizontalTextAlignment="Center" />
            <Button Text="Sign in with Google" Clicked="OnSignInClicked" />
        </VerticalStackLayout>

        <!-- Signed in -->
        <RefreshView
            IsVisible="{Binding IsSignedIn}"
            IsRefreshing="{Binding IsLoading}"
            Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplateSelector}">
                <CollectionView.Header>
                    <Label
                        Text="{Binding ErrorText}"
                        IsVisible="{Binding HasError}"
                        Padding="16,8"
                        TextColor="Red"
                        FontSize="13" />
                </CollectionView.Header>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
