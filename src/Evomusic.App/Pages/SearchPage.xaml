<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Evomusic.App.Pages"
             x:Class="Evomusic.App.Pages.SearchPage"
             x:DataType="pages:SearchPage"
             ControlTemplate="{StaticResource PlayerChrome}"
             Title="Search">

    <Grid RowDefinitions="Auto,*">
        <SearchBar
            x:Name="QueryBar"
            Placeholder="Songs, albums, artists"
            TextChanged="OnQueryChanged"
            SearchButtonPressed="OnSearchPressed" />

        <!-- Results -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Rows}"
            ItemTemplate="{StaticResource RowTemplateSelector}"
            IsVisible="{Binding ShowResults}">
            <CollectionView.EmptyView>
                <Label
                    Text="{Binding Message}"
                    Padding="24"
                    HorizontalTextAlignment="Center"
                    TextColor="{StaticResource Gray400}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Suggestions while typing -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Suggestions}"
            IsVisible="{Binding ShowSuggestions}"
            SelectionMode="Single"
            SelectionChanged="OnSuggestionSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}" Padding="16,12" FontSize="17" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Start" Margin="0,24" />
    </Grid>

</ContentPage>
